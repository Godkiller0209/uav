venv/
.venv/
env/
ENV/

# Environment variables and local secrets
.env
.env.*
!.env.example

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*~

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging output
build/
dist/
*.egg-info/

# Local mission data (may contain real search-area coordinates)
/data/search_area.json
/data/search_areas.json
/data/waypoints.json
/data/logs/
